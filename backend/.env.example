# Application
APP_NAME=SentinelAI
APP_PORT=8000
APP_ENV=development
DEBUG=True

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/sentinelai

# Authentication
JWT_SECRET=your_secure_jwt_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Initial Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=secure_admin_password_here

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI / Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=30.0
MAX_PROMPT_SIZE=4096
